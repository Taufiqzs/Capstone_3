# GCP_PROJECT_ID identifies Taufiq's Google Cloud project for every API call.
GCP_PROJECT_ID=jcdeah-009
# GCP_REGION keeps regional GCS, BigQuery, and Dataflow resources colocated.
GCP_REGION=us-central1
# STUDENT_ID is the official course identity used in submission and resource names.
STUDENT_ID=taufiqzahrus

# GCS_BUCKET stores raw batch files plus temporary Dataflow artifacts.
GCS_BUCKET=taufiqzahrus-capstone3
# BIGQUERY_DATASET contains the staging, intermediate, and mart tables.
BIGQUERY_DATASET=taufiqzahrus_capstone3
# PUBSUB_TOPIC receives the generated June-July taxi events.
PUBSUB_TOPIC=taufiqzahrus-green-taxi-events
# PUBSUB_SUBSCRIPTION is the pull subscription consumed only by Dataflow.
PUBSUB_SUBSCRIPTION=taufiqzahrus-green-taxi-dataflow

# EVENT_RATE sets the default number of events published per second.
EVENT_RATE=5
# EVENT_COUNT sets the default number of events; zero means run continuously.
EVENT_COUNT=100